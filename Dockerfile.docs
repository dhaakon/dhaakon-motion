FROM node:24-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json .npmrc tsconfig.json tsup.config.ts ./
RUN npm ci --ignore-scripts
COPY src ./src
COPY docs ./docs
COPY wasm ./wasm
RUN npm run docs:build

FROM nginx:1.27-alpine AS serve
COPY docs/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/docs/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s CMD curl -fsS http://localhost:8080/ -o /dev/null || exit 1
