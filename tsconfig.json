{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "declaration": true, "esModuleInterop": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@dhaakon/motion": ["src/index.ts"],
      "@dhaakon/motion/compiled": ["src/compiled.ts"],
      "@dhaakon/motion/wasm/*": ["wasm/*"],
      "@dhaakon/motion/react": ["src/react.tsx"],
      "@dhaakon/motion/three": ["src/three.ts"],
      "@dhaakon/motion/audio": ["src/audio.ts"],
      "@dhaakon/motion/midi": ["src/midi.ts"],
      "@dhaakon/motion/testing": ["src/testing.ts"],
      "@dhaakon/motion/devtools": ["src/devtools.ts"],
      "@dhaakon/motion/gesture": ["src/gesture/index.ts"]
    }
  },
  "include": ["src", "docs", "tests"]
}
