{
  "name": "@dhaakon/motion",
  "version": "0.8.0",
  "description": "Optimized tween, timeline, transport, and React composition primitives for the Dhaakon network.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js",
      "require": "./dist/css.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js",
      "require": "./dist/three.cjs"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js",
      "require": "./dist/audio.cjs"
    },
    "./midi": {
      "types": "./dist/midi.d.ts",
      "import": "./dist/midi.js",
      "require": "./dist/midi.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "require": "./dist/devtools.cjs"
    },
    "./compiled": {
      "types": "./dist/compiled.d.ts",
      "import": "./dist/compiled.js",
      "require": "./dist/compiled.cjs"
    },
    "./wasm/*": "./wasm/*",
    "./gesture": {
      "types": "./dist/gesture.d.ts",
      "import": "./dist/gesture.js",
      "require": "./dist/gesture.cjs"
    }
  },
  "publishConfig": {
    "registry": "http://dhaakon-ubuntu:21760/"
  },
  "scripts": {
    "build": "tsup",
    "rust:setup": "node scripts/setup-rust.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "bench:engine": "node --expose-gc scripts/bench-engine.mjs",
    "test:wasm": "node scripts/test-wasm.mjs",
    "test:rust": "node scripts/test-rust.mjs",
    "test:packed-engine": "node scripts/test-packed-engine.mjs",
    "profile:cue": "npm run docs:build && node scripts/profile-cue.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "npm run build && node --test tests/dist/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run test:dist",
    "docs:dev": "vite --config docs/vite.config.ts --host 0.0.0.0",
    "docs:build": "vite build --config docs/vite.config.ts",
    "docs:check": "npm run format:check && npm run docs:build && node docs/scripts/check-build.mjs",
    "docs:smoke": "node docs/scripts/smoke.mjs",
    "docs:render-cue": "npm run docs:build && node docs/scripts/render-cue.mjs",
    "docs:verify-cue": "npm run docs:build && node docs/scripts/verify-cue.mjs",
    "docs:verify-rust": "npm run docs:build && node docs/scripts/verify-rust.mjs",
    "docs:verify-css-ui": "npm run docs:build && node docs/scripts/verify-css-ui.mjs",
    "check:all": "npm run check && npm run docs:check && npm run docs:smoke && node docs/scripts/verify-css-ui.mjs && node docs/scripts/verify-rust.mjs && node docs/scripts/verify-cue.mjs",
    "bench:gestures": "npm run build && node docs/scripts/gesture-bench.mjs",
    "format:docs": "prettier --write docs/src/App.tsx docs/src/routes.ts docs/src/router.ts docs/src/routes.css docs/src/pages docs/src/labs docs/src/examples docs/src/components docs/src/AdvancedCueSheetLab.tsx docs/src/advancedCueSheet.ts docs/src/cue-sheet docs/scripts docs/source-aliases.ts",
    "format:check": "prettier --check docs/src/App.tsx docs/src/routes.ts docs/src/router.ts docs/src/routes.css docs/src/pages docs/src/labs docs/src/examples docs/src/components docs/src/AdvancedCueSheetLab.tsx docs/src/advancedCueSheet.ts docs/src/cue-sheet docs/scripts docs/source-aliases.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dhaakon/ui": "0.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "prettier": "3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
